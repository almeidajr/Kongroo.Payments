{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "OutboxProcessing": {
    "PollingInterval": "00:00:05",
    "BatchSize": 20
  },
  "Payments": {
    "ApprovalLimit": 1000.00
  },
  "AllowedHosts": "*"
}
